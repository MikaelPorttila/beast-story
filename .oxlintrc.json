{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "builtin": true
  },
  "plugins": ["eslint", "typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "curly": ["error", "all"],
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-console": "warn"
  },
  "ignorePatterns": ["dist/**", "coverage/**"]
}
